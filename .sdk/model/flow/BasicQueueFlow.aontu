# BasicQueueFlow

main: kit: flow: BasicQueueFlow:
{
  entity: "queue",
  kind: "basic",
  name: "BasicQueueFlow",
  step: [
    {
      i: {
        ref: "queue_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "queue_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "queue_ref01",
        srcdatavar: "queue_ref01_data",
        suffix: "_up0",
        textfield: "jurisdiction"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-queue_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "queue_ref01",
        srcdatavar: "queue_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "queue01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-queue_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "queue_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "queue01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "queue_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicQueueFlow"
}